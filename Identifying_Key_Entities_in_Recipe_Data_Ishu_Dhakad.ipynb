  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {
    "id": "-4aMFCxXO_GJ"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Unique labels: ['ingredient', 'quantity', 'unit']\n"
     ]
    }
   ],
   "source": [
    "# Define a unique_labels function to checks for all the unique pos labels in the recipe & print it\n",
    "def unique_labels(pos_token_lists):\n",
    "    return sorted(set(label for labels in pos_token_lists for label in labels))\n",
    "\n",
    "labels = unique_labels(df[\"pos_tokens\"])\n",
    "print(\"Unique labels:\", labels)\n"
   ]
