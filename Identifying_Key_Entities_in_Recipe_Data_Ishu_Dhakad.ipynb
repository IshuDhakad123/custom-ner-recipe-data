    "# define a function to load json file to a dataframe\n",
    "import json\n",
    "import pandas as pd\n",
    "\n",
    "def load_json_dataframe(file_path):\n",
    "    with open(file_path, \"r\", encoding=\"utf-8\") as file:\n",
    "        data = json.load(file)\n",
    "    \n",
    "    return pd.DataFrame(data)"
